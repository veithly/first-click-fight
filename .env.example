# Public base URL for share links and QR routes.
NEXT_PUBLIC_BASE_URL=http://localhost:4387

# Optional. Novus.ai (Pendo) is a GitHub-connected product agent that
# auto-instruments via a pull request; it does not use a public client id.
# Leave blank. The real, inspectable usage-learning loop lives in D1 usage_events.
NEXT_PUBLIC_NOVUS_APP_ID=

# Server secret used to sign owner rematch keys (HMAC-SHA256). Store in
# .dev.vars locally and as a Wrangler secret in production:
#   npx wrangler secret put OWNER_KEY_SECRET
OWNER_KEY_SECRET=replace-with-a-32-byte-random-hex
